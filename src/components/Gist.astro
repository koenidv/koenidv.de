---
export interface Props {
	/** Full gist URL, e.g. "https://gist.github.com/koenidv/35da9f28a19fdcb249412f9cfe72ce68" */
	url: string;
	/** Restrict the embed to a single file within a multi-file gist */
	file?: string;
	/** Defaults to the filename, or "owner/id" if no file is given */
	title?: string;
}

const { url, file, title } = Astro.props;

const parsed = new URL(url);
const [, owner, id] = parsed.pathname.split("/");
const embedSrc = `${parsed.origin}${parsed.pathname}.js${file ? `?file=${encodeURIComponent(file)}` : ""}`;
const displayTitle = title ?? file ?? `${owner}/${id}`;
const collapseId = `gist-${id}${file ? `-${file.replace(/[^a-z0-9]/gi, "")}` : ""}`;
---

<div class="gist-embed not-prose my-6 overflow-hidden rounded-sm border border-beige-200 bg-white" data-gist>
	<div class="flex items-center justify-between gap-2 border-b border-beige-200 bg-beige-100/60 px-4 py-2 font-mono text-sm">
		<a
			href={url}
			target="_blank"
			rel="noopener noreferrer"
			class="flex min-w-0 items-center gap-2 text-gray-700 hover:text-purple-600 hover:underline underline-offset-[0.2rem]">
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" class="h-4 w-4 shrink-0" fill="currentColor" aria-hidden="true">
				<path fill-rule="evenodd" clip-rule="evenodd" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38
					0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13
					-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66
					.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15
					-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09
					2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15
					0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2
					0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" />
			</svg>
			<span class="truncate">{displayTitle}</span>
		</a>
		<button
			type="button"
			class="gist-copy-btn flex shrink-0 items-center gap-1.5 rounded-sm border border-beige-200 bg-beige-100 px-2.5 py-1 text-xs font-medium text-gray-600 hover:border-purple-300 hover:bg-purple-50 hover:text-purple-600 focus-visible:border-purple-300 focus-visible:bg-purple-50 focus-visible:text-purple-600"
			aria-label={`Copy code from ${displayTitle}`}
			data-target={collapseId}>
			<span class="gist-copy-label">Copy</span>
			<svg xmlns="http://www.w3.org/2000/svg" class="gist-copy-icon h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
				<path d="M7 9a2 2 0 012-2h6a2 2 0 012 2v6a2 2 0 01-2 2H9a2 2 0 01-2-2V9z" />
				<path d="M5 3a2 2 0 00-2 2v6a2 2 0 002 2V5h8a2 2 0 00-2-2H5z" />
			</svg>
		</button>
		<span class="sr-only" role="status" aria-live="polite"></span>
	</div>

	<div class="gist-collapse relative overflow-hidden" id={collapseId}>
		<script is:inline src={embedSrc}></script>
		<div class="gist-fade pointer-events-none absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-white to-transparent" aria-hidden="true">
		</div>
	</div>

	<button
		type="button"
		class="gist-toggle-btn w-full border-t border-beige-200 bg-beige-100/60 py-2 font-mono text-sm text-gray-600 hover:text-purple-600"
		data-target={collapseId}
		aria-expanded="false">
		Show more
	</button>
</div>

<script src="../scripts/gist.js"></script>
