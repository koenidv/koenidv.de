---
interface Props {
  inverse?: boolean;
  /**
   * Hide every copy from assistive tech. Use when the marquee text merely
   * repeats a heading that is already announced elsewhere on the page.
   */
  decorative?: boolean;
}

const { inverse = false, decorative = false } = Astro.props;
---

<div class={inverse ? "marquee-container-right" : "marquee-container-left"}>
  <div class="marquee no-margin-children">
    {/* The copies exist to make the loop seamless, so only the first is exposed */}
    <div class="marquee-copy" aria-hidden={decorative ? "true" : undefined}><slot /></div>
    <div class="marquee-copy" aria-hidden="true"><slot /></div>
    <div class="marquee-copy" aria-hidden="true"><slot /></div>
    <div class="marquee-copy" aria-hidden="true"><slot /></div>
  </div>
</div>

<style>
  .marquee-container-left {
    position: relative;
    overflow: hidden;
    --offset: 20vw;
    --move-initial: calc(-25% + var(--offset));
    --move-final: calc(-50% + var(--offset));
  }

  .marquee-container-right {
    position: relative;
    overflow: hidden;
    --offset: 20vw;
    --move-initial: calc(-50% + var(--offset));
    --move-final: calc(-25% + var(--offset));
  }

  .marquee {
    width: fit-content;
    display: flex;
    flex-direction: row;
    position: relative;
    width: max-content;
    align-items: center;
    font-size: 10vw;
    font-family: 'Poppins', sans-serif;
    font-weight: 900;

    /* The spacing lives on the copies, not here, so that one copy plus its
       trailing gap is exactly 25% of the track and the loop is seamless. */
    gap: 0;

    transform: translate3d(var(--move-initial), 0, 0);
    animation: marquee 30s linear infinite;
  }

  .marquee-copy {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 2rem;
    padding-right: 2rem;
  }

  .marquee :global(p) {
    color: #131218;
  }

  /* Scoped to the text elements themselves: the .marquee-copy wrappers are now
     the direct children, and a bare :nth-of-type(even) would outline whole copies. */
  @supports (-webkit-text-stroke: 1px white) {
    .marquee :global(:is(p, h1, h2, h3):nth-of-type(even)) {
      color: theme('colors.beige.100');
      -webkit-text-stroke: 2px black;
    }
  }

  @media screen and (min-width: 48rem) {
    .marquee {
      font-size: 6rem;
    }

    .marquee-copy {
      gap: 4rem;
      padding-right: 4rem;
    }

    @supports (-webkit-text-stroke: 1px white) {
      .marquee :global(:is(p, h1, h2, h3):nth-of-type(even)) {
        -webkit-text-stroke: 0.15rem black;
      }
    }
  }

  .marquee p {
    margin: 0;
  }

  @keyframes marquee {
    0% {
      transform: translate3d(var(--move-initial), 0, 0);
    }

    100% {
      transform: translate3d(var(--move-final), 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee {
      animation: none;
      transform: none;
    }
  }
</style>
