<form name="contact" data-netlify="true" method="post" class="contactformgrid gap-6 md:gap-12">
	<div
		class="flex-grow flex flex-col gap-4 bg-beige-300 bg-opacity-30 md:-m-4 md:p-4 z-0 rounded"
		style="grid-area: person;">
		<h3 class="text-xl md:text-2xl lg:text-3xl xl:text-4xl font-poppins font-black">Tell me about yourself</h3>
		<div class="flex flex-col gap-1">
			<label for="contact-name">Your Name <span aria-hidden="true">*</span></label>
			<div class="group">
				<div class="elevated-card-hoverable elevated-2">
					<input
						type="text"
						id="contact-name"
						name="name"
						placeholder="Erich Doe"
						required
						autocomplete="name"
						class="block p-2 border-l-4 border-t-4 border-r-2 border-b-2 border-black h-full w-full bg-beige-50"
					/>
				</div>
			</div>
		</div>
		<div class="flex flex-col gap-1">
			<label for="contact-email">Your Email <span aria-hidden="true">*</span></label>
			<div class="group">
				<div class="elevated-card-hoverable elevated-2">
					<input
						type="email"
						id="contact-email"
						name="email"
						required
						autocomplete="email"
						placeholder="erich@doenut.co"
						class="block p-2 border-l-4 border-t-4 border-r-2 border-b-2 border-black h-full w-full bg-beige-50"
					/>
				</div>
			</div>
		</div>
	</div>
	<div class="flex-grow flex flex-col gap-4 md:mb-4" style="grid-area: message;">
		<h3 class="text-xl md:text-2xl lg:text-3xl xl:text-4xl font-poppins font-black">
			& what you've got in mind
		</h3>
		<label for="contact-message" class="sr-only">Your message</label>
		<div class="group">
			<div class="elevated-card-hoverable elevated-4">
				<div
					class="grow-wrap after:p-2 after:border-l-4 after:border-t-4 after:border-r-2 after:border-b-2 min-h-[16rem]"
					data-replicated-value="Yoo Florian,\n\nI've got this crazy idea for a doughnut-shaped spaceship. Complete with rotating outer rings that simulate gravity through centrifugal force. The central hole housing would be a zero-gravity donut bakery to satisfy our interstellar cravings.\n\nIt'll be called Spacedoe, let's build it!">
					<textarea
						id="contact-message"
						name="message"
						required
						oninput="this.parentNode.dataset.replicatedValue = this.value || this.placeholder"
						placeholder="Yoo Florian,\n\nI've got this crazy idea for a doughnut-shaped spaceship. Complete with rotating outer rings that simulate gravity through centrifugal force. The central hole housing would be a zero-gravity donut bakery to satisfy our interstellar cravings.\n\nIt'll be called Spacedoe, let's build it!"
						class="p-2 border-l-4 border-t-4 border-r-2 border-b-2 border-black bg-beige-50"></textarea>
				</div>
			</div>
		</div>
	</div>
	<div style="grid-area: submit;">
		<div class="group flex justify-center md:justify-end relative">
			<div class="elevated-card-hoverable elevated-2 w-full md:w-auto min-w-[61.8%] 2xl:w-fit">
				<div
					class="border-l-4 border-t-4 border-r-2 border-b-2 border-black h-full w-full flex items-center justify-center py-2">
					<input
						type="submit"
						value="Send this message"
						class="block w-full h-full min-h-[2.75rem] cursor-pointer group-hover:underline underline-offset-[0.3rem] decoration-[0.125rem]"
					/>
				</div>
			</div>
		</div>
	</div>
</form>
