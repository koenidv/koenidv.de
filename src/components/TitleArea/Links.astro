---
export interface Props {
	showBlog?: boolean;
}
const { showBlog } = Astro.props;
---

<nav
	aria-label="Main"
	id="links"
	class="h-14 flex flex-row gap-4 md:gap-3 my-0 mx-6 items-center justify-center md:justify-end">
	<a href="/projects" class="py-2">Projects</a>
	{showBlog && <a href="/blog" class="py-2">Articles</a>}
	<a href="#about" class="py-2">About</a>
	<a href="#contact" class="py-2">Contact</a>
</nav>
